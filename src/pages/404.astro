---
import Base from '../layouts/Base.astro';
---
<Base htmlAttrs={{ lang: 'pt-BR' }}>
<Fragment slot="head">
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Página não encontrada | Eduardo Gomes</title>
<meta name="robots" content="noindex">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@700..800&family=Funnel+Sans:wght@400..600&family=Reddit+Mono:wght@500&display=swap">
<script is:inline src="/inicio.js" blocking="render"></script>
<style is:inline set:html={`.nf{min-height:100vh;display:grid;place-content:center;gap:16px;padding:var(--gutter,24px);text-align:left}.nf h1{font-family:var(--f-display,inherit);font-size:clamp(2.5rem,8vw,5rem);margin:0}.nf p{margin:0;color:var(--muted)}`}></style>
</Fragment>
<main class="nf" id="conteudo">
  <p class="mono">404</p>
  <h1>Página não encontrada</h1>
  <p>O endereço não existe neste site.</p>
  <p><a class="btn primary" href="/">Voltar para o início</a></p>
  <p lang="en" class="nf-en">Page not found. This address does not exist on this site. <a href="/en/">Back to the English home page</a>.</p>
</main>
</Base>
