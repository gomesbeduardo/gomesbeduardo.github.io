---
import { dicionario } from '../i18n';
import type { Lang } from '../i18n/tipos';
interface Props { lang: Lang }
const { home: t } = dicionario(Astro.props.lang);
const s = t.experiencia;
// Chave de cada item, na ordem de s.itens; igual nos dois idiomas.
const chaves = ['centraleng', 'asten', 'amf', 'yourmentor', 'ideathon-2025', 'ideathon-2026', 'coderace-2026', 'jet', 'voluntariado'];
---
<section id="experiencia"><div class="wrap">
  <p class="sec-label reveal" aria-hidden="true" set:html={s.label}></p>
  <h2 class="reveal" data-ancora="experiencia-titulo" set:html={s.titulo}></h2>
  <ol class="timeline">
    {s.itens.map((i, n) => <li class="stag" data-ancora={`exp-${chaves[n]}`}><span class="when" set:html={i.quando}></span><span class="what"><Fragment set:html={i.titulo} /><small set:html={i.papel}></small></span>{i.texto && <p set:html={i.texto}></p>}</li>)}
  </ol>
</div></section>
