---
import { dicionario } from '../i18n';
import type { Lang } from '../i18n/tipos';
import { icone, LINKS } from './icones';
interface Props { lang: Lang }
const { home: t } = dicionario(Astro.props.lang);
const s = t.modal;
---
<dialog class="modal" id="sobre-site" aria-labelledby="sobre-site-t" data-lenis-prevent>
<div class="modal-in">
<button class="icon-btn modal-x" type="button" data-fechar aria-label={s.fechar}><Fragment set:html={icone('close')} /></button>
<h2 id="sobre-site-t" tabindex="-1">{s.titulo}</h2>
<p set:html={s.intro}></p>
{s.secoes.map((x) => <Fragment><h3>{x.titulo}</h3>
<p set:html={x.texto}></p></Fragment>)}
<h3>{s.perfil.titulo}</h3>
<p set:html={s.perfil.texto}></p>
<ul>
{s.perfil.itens.map((i) => <li set:html={i}></li>)}
</ul>
<p><a href={LINKS.repositorio} rel="noopener">{s.link}</a></p>
</div>
</dialog>
