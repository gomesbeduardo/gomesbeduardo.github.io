---
import { dicionario } from '../i18n';
import type { Lang } from '../i18n/tipos';
interface Props { lang: Lang }
const { home: t } = dicionario(Astro.props.lang);
const h = t.hero;
---
<section class="hero" id="inicio" data-ancora="hero"><div class="wrap">
  <div class="name-row">
    <h1 class="reveal name pre"><span>Eduardo</span><span class="l2"><span class="base" aria-hidden="true"><span class="ch">G</span><span class="ch">o</span><span class="ch">m</span><span class="ch">e</span><span class="ch">s</span></span><span class="fill" aria-hidden="true"><span class="ch" style="--i:0">G</span><span class="ch" style="--i:1">o</span><span class="ch" style="--i:2">m</span><span class="ch" style="--i:3">e</span><span class="ch" style="--i:4">s</span></span><span class="sr-only">Gomes</span></span></h1>
    <div class="photo" data-flip><div class="photo-card"><button class="photo-btn" id="sp-foto" type="button" aria-label={h.fotoAria}><img src={t.base + h.fotoSrc} alt="Eduardo Gomes" width="460" height="460" decoding="async"></button></div></div>
  </div>
  <p class="title-line">
    <span class="sr-only" set:html={h.srTitulo}></span>
    {h.fantasmas.map((g) => <span class="ghost" aria-hidden="true" set:html={g}></span>)}
    <span class="anim" id="typing" aria-hidden="true" set:html={h.digitando}></span>
  </p>
  <div class="actions"><a class="btn primary" href="#projetos">{h.verProjetos}</a><a class="btn" href={t.base + h.curriculoHref} download><Fragment set:html={`<svg class="icon"><use href="#i-down"/></svg>`} />{h.curriculoTexto}</a></div>
  <p class="facts">{h.fatos.map((f) => <span set:html={f}></span>)}</p>
</div></section>
