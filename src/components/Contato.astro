---
import { dicionario } from '../i18n';
import type { Lang } from '../i18n/tipos';
import { icone, LINKS } from './icones';
interface Props { lang: Lang }
const { home: t } = dicionario(Astro.props.lang);
const s = t.contato;
---
<section id="contato"><div class="wrap">
  <p class="sec-label reveal" aria-hidden="true">{s.label}</p>
  <h2 class="reveal">{s.titulo}</h2>
  <p class="mono">{s.local}</p>
  <ul class="links">
    <li class="stag"><button type="button" data-copiar-email aria-label={s.emailAria}><span class="lbl">{s.email}</span> <Fragment set:html={icone('copy')} /></button></li>
    <li class="stag"><a href={LINKS.linkedin} rel="noopener"><span class="lbl">LinkedIn</span> <Fragment set:html={icone('arrow')} /></a></li>
    <li class="stag"><a href={LINKS.github} rel="noopener"><span class="lbl">GitHub</span> <Fragment set:html={icone('arrow')} /></a></li>
    <li class="stag"><a href={`${t.base}curriculo/${s.curriculoArquivo}`} download><span class="lbl">{s.curriculo}</span> <Fragment set:html={icone('down')} /></a></li>
  </ul>
</div></section>
